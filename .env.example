# Public browser-safe Supabase settings. Obtain these from a development project.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only deployment identity. Never prefix secrets with NEXT_PUBLIC_.
APP_ENV=local
APP_VERSION=development
SUPABASE_PROJECT_REF=
# Non-secret safety comparison used only by the production preflight.
DEVELOPMENT_SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
BILLING_ENVIRONMENT=sandbox

# Provider-neutral transactional email configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional production operations integrations.
ERROR_MONITORING_DSN=
RATE_LIMIT_REST_URL=
RATE_LIMIT_REST_TOKEN=
CRON_SECRET=
